&miscparameters
 option='panel',
 max_number_of_panels=80,
 max_number_of_transforms=20,
 angle_units='degrees'
/
&vtkfiles
 vtk_input_file='GEOM.vtk'
 number_of_copies=1
/
&panelarrayparameters
      panel_bodies=1
      panel_transform=1
/
&positionparameters
      position_transform=1,  
      position_scale=0.001,0.001,0.001
/
