#!/usr/bin/env python3
"""Compare log files generated by smiter."""

import argparse
from dataclasses import dataclass, field
from typing import Any, Dict, List, TextIO, Tuple

DEFAULT_TOL = 1e-8


@dataclass
class LogFile:
    file_name: str = ""
    timestamp: str = ""
    values: Dict[str, Any] = field(default_factory=dict)
    benchmarks: Dict[str, float] = field(default_factory=dict)
    info: List[str] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)
    footers: Dict[str, int] = field(default_factory=dict)


@dataclass
class Args:
    log_file: str
    ref_file: str
    abs_tol: float
    rel_tol: float


def parse_args(sys_args: List[str]) -> Args:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("log_file", help="the log file to test the contents of")
    parser.add_argument("ref_file", help="the reference log file to compare against")
    parser.add_argument(
        "--abs-tol",
        help="absolute equality tolerance for floats",
        default=DEFAULT_TOL,
        type=float,
    )
    parser.add_argument(
        "--rel-tol",
        help="relative equality tolerance for floats",
        default=DEFAULT_TOL,
        type=float,
    )
    args = parser.parse_args(sys_args)
    return Args(**vars(args))


def read_file(file_path: str) -> LogFile:
    with open(file_path, "r") as f:
        return parse_file(f)


def parse_file(stream: TextIO) -> LogFile:
    log_file = LogFile()
    log_file.file_name, log_file.timestamp = _read_headers(stream)

    values = {}
    benchmarks = {}
    for line in stream:
        line = line.strip()
        if not line:
            continue

        if line.startswith("Log"):
            log_entry = line.split(":", 1)[1].strip()
            if _is_info(log_entry):
                info = log_entry.split(":", 1)[1].strip()
                log_file.info.append(info)
            elif _is_benchmark(log_entry):
                parts = [part.strip() for part in log_entry.split(" = ")]
                benchmarks[parts[0]] = float(parts[1].replace(" secs", ""))
            else:
                key, value = _parse_value(log_entry)
                values[key] = value
        elif _is_warning(line):
            log_file.warnings.append(line)
        elif _is_error_summary(line):
            footers = _read_footers(stream)
        elif _is_end(line):
            break

    log_file.benchmarks = benchmarks
    log_file.footers = footers
    log_file.values = values
    return log_file


def compare_logs(log: LogFile, ref_log: LogFile, abs_tol: float, rel_tol: float) -> bool:
    if log.values.keys() != ref_log.values.keys():
        return False
    if log.warnings != ref_log.warnings:
        return False
    if log.info != ref_log.info:
        return False
    if log.footers != ref_log.footers:
        return False
    for k, value in log.values.items():
        ref_value = ref_log.values[k]
        if type(value) != type(ref_value):
            return False
        if isinstance(value, float):
            if abs(value - ref_value) > abs_tol + rel_tol*abs(ref_value):
                return False
        else:
            if value != ref_value:
                return False
    return True


def _read_headers(stream: TextIO) -> Tuple[str, str]:
    """Read the file name and timestamp from the file header."""
    next(stream)  # skip blank line
    file_name = next(stream).split(":")[-1].strip()
    next(stream)  # skip blank line
    timestamp = next(stream).strip()
    return file_name, timestamp


def _read_footers(stream: TextIO) -> Dict[str, int]:
    footers = {}
    next(stream)  # skip underline
    for _ in range(2):
        parts = [part.strip() for part in next(stream).split(" = ")]
        footers[parts[0]] = parts[1]
    return footers


def _is_info(log_entry: str) -> bool:
    return log_entry.startswith("Info")


def _is_warning(log_entry: str) -> bool:
    return ": Warning: " in log_entry


def _is_benchmark(log_entry: str) -> bool:
    return " time  =  " and log_entry.endswith("secs")


def _is_error_summary(line: str) -> bool:
    return line == "Error Summary"


def _is_end(line: str) -> bool:
    return line == "END OF LOG FILE"


def _parse_value(log_entry: str) -> Tuple[str, str]:
    parts = [part.strip() for part in log_entry.split(" = ")]
    if len(parts) > 2:
        raise Exception(
            "parsing error: found more than one ' = ' in log entry: " f"'{log_entry}'"
        )
    elif len(parts) < 2:
        raise Exception(f"parsing error: no ' = ' found in log entry: '{log_entry}'")
    try:
        return parts[0], float(parts[1])
    except ValueError:
        return parts[0], parts[1]


if __name__ == "__main__":
    import sys

    args = parse_args(sys.argv[1:])
    log_file = read_file(args.log_file)
    reference_file = read_file(args.ref_file)
    logs_equal = compare_logs(log_file, reference_file, args.abs_tol, args.rel_tol)
    sys.exit(not logs_equal)
