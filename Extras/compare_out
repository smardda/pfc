#!/usr/bin/env python3
"""
Parse and compare '.out' files generated by SMARDDA with a numerical
tolerance.

Return a non-zero exit code if any differences are found between the
files.
"""

import argparse
from dataclasses import dataclass
from typing import Any, Dict, List, TextIO, Tuple, Union

import numpy as np


def read_out_file(file_path: str) -> Tuple[Dict[str, Any], Dict]:
    with open(file_path, "r") as stream:
        metadata = _read_metadata(stream)
        if _peek_line(stream).startswith("statistics"):
            # '.out' file is a cell-data file
            data = {}
            data["stats"] = _read_statistics(stream)
            data["cells"] = _read_cell_data(stream)
        else:
            # '.out' file is a 'powcal' data file
            data = _read_powcal_data(stream)
    return data, metadata


def data_equal(data1: Dict, data2: Dict) -> bool:
    if data1.keys() != data2.keys():
        return False
    for k, v1 in data1.items():
        v2 = data2[k]
        if isinstance(v1, (np.ndarray, float)):
            if not np.isclose(v1, v2).all():
                return False
        elif isinstance(v1, dict):
            return data_equal(v1, v2)
        elif v1 != v2:
            return False
    return True


@dataclass
class Args:
    test_file: str
    ref_file: str


def parse_args(sys_args: List[str]):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("test_file", help="the file to compare")
    parser.add_argument("ref_file", help="the reference file to compare against")
    return Args(**vars(parser.parse_args(sys_args)))


def _read_metadata(stream: TextIO) -> Dict:
    metadata = {}
    metadata["file_name"] = stream.readline().strip()
    metadata["timestamp"] = stream.readline().strip()
    while True:
        cursor_position = stream.tell()
        line = stream.readline().strip()
        if " = " not in line:
            stream.seek(cursor_position)
            break
        key, value = key, value = [part.strip() for part in line.split(" = ", 1)]
        metadata[key] = value
        stream.readline()  # skip blank line
    return metadata


def _read_powcal_data(stream: TextIO) -> Dict:
    data: Dict[str, Union[float, str, np.ndarray]] = {}
    while line := stream.readline():
        key = line.strip()
        value = stream.readline().strip().split()
        if len(value) > 1:
            try:
                value = np.loadtxt(value)
            except ValueError:
                pass  # we've got a list of things that are not numbers
        else:
            value = value[0]
            try:
                value = float(value)
            except ValueError:
                pass  # we've got something that's not a number
        data[key] = value
    return data


def _read_cell_data(stream: TextIO) -> List:
    data = []
    while True:
        cell = {}
        cell_line = stream.readline().strip().split()
        if len(cell_line) < 2:
            break
        cell["cell"] = [cell_line[1:]]
        layout_line = stream.readline().strip().split()
        cell["layout"] = [int(x) for x in layout_line[1:]]
        n_data_lines = cell["layout"][0]
        values = " ".join([stream.readline().strip() for _ in range(n_data_lines)])
        cell["values"] = np.loadtxt(values, dtype=int)
        data.append(cell)
    return data


def _read_statistics(stream: TextIO) -> Dict[str, int]:
    stats = {}
    stream.readline()  # skip block start
    for line in stream:
        line = line.strip()
        if line == "end_statistics":
            break
        parts = [part.strip() for part in line.split()]
        stats[" ".join(parts[0:-1])] = int(parts[-1])
    return stats


def _peek_line(stream: TextIO) -> str:
    pos = stream.tell()
    line = stream.readline()
    stream.seek(pos)
    return line


if __name__ == "__main__":
    import sys

    args = parse_args(sys.argv[1:])
    test_data, _ = read_out_file(args.test_file)
    ref_data, _ = read_out_file(args.ref_file)
    sys.exit(not data_equal(test_data, ref_data))
