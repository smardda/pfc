#! /bin/bash --norc
#produce executables once git repository cloned
#options compiler=intel, gfortran (default)
#Y/N produce documentation, default produce (Y)
set -e
if [[ -z "$SMITER_DIR" ]] ; then
   export SMITER_DIR=$PWD
fi
if [[ ! -d "$SMITER_DIR" ]] ; then
   echo "SMARDDA-PFC modules must lie under directory \$SMITER_DIR = "$SMITER_DIR
   echo "Which does not exist, please reconcile and try again"
   exit 1 
fi
if [[ -z "$SMALIB_DIR" ]] ; then
   export SMALIB_DIR=${SMITER_DIR%/*}/smardda-lib
fi
if [[ ! -d "$SMALIB_DIR" ]] ; then
   echo "SMARDDA-LIB modules must lie under directory \$SMALIB_DIR = "$SMALIB_DIR
   echo "Which does not exist, please reconcile and try again"
   exit 1
fi
#echo $SMITER_DIR $SMALIB_DIR
compiler1=intel
compiler2=intel_dbg
compiler3=gfortran
compiler4=gfortran_dbg
compiler5=gfortranmpi
compiler6=gfortranmpi_dbg
compiler7=intelmpi
compiler8=intelmpi_dbg
if [ "$1" == "$compiler1" ] ; then
    compiler=$compiler1
elif [ "$1" == "$compiler2" ] ; then
    compiler=$compiler2
elif [ "$1" == "$compiler3" ] ; then
    compiler=$compiler3
elif [ "$1" == "$compiler5" ] ; then
    compiler=$compiler5
elif [ "$1" == "$compiler6" ] ; then
    compiler=$compiler6
elif [ "$1" == "$compiler7" ] ; then
    compiler=$compiler7
elif [ "$1" == "$compiler8" ] ; then
    compiler=$compiler8
else
    compiler=$compiler4
fi

echo "Building SMARDDA-PFC with" $compiler

#(Re)generate documentation option, can take minutes
if [ $# = 2 ] ; then
   newdoc=$2
elif [ "$1" == N ] ; then
   newdoc=N
else
   newdoc=Y
fi

if [ -f $SMITER_DIR/Extras/setup ] ; then
	source $SMITER_DIR/Extras/setup
 	echo "you may want to add 'source "$SMITER_DIR"/Extras/setup' to your .bashrc file"
else
	echo "Something is wrong - smardda-pfc repository not cloned?"
fi
if [ -f $SMITER_DIR/../gwit/setup ] ; then
#give user access to gwit interface to git
	source $SMITER_DIR/../gwit/setup
	echo "you may want to add 'source "$SMITER_DIR"/../gwit/setup' to your .bashrc file"
fi

#ln -sf $SMITER_DIR/config/config_"$compiler"_dbg.inc $SMITER_DIR/config/config.inc
#ln -sf $SMITER_DIR/config/config_"$compiler".inc $SMITER_DIR/config/config.inc
#should add a consistency test for compiler configs (TO DO)
#rm required on WSL, should be harmless otherwise
rm -f config
ln -sf $SMALIB_DIR/config $SMITER_DIR/config

#sed -e "s=SMALIB=$SMALIB_DIR=" < $SMALIB_DIR/config/path_generic.inc > $SMALIB_DIR/config/path.inc

#make sure executables are
chmod a+x $SMITER_DIR/Extras/chmodx
$SMITER_DIR/Extras/chmodx

#produce the fortran executables 
$SMITER_DIR/exec/compile

#read -p '(Re)generate documentation, can take minutes? (Y/N): ' newdoc
if [ "$newdoc" == "Y" ] ; then
cd $SMITER_DIR/doc
echo "Warning - Documentation production requires doxygen at 1.8 or later"
doxygen doxyfile
if [  $? == 0 ] ; then 
  echo "to access documentation type firefox  or xdg-open $SMITER_DIR/doc/srcdoc/html/index.html"
else
  echo "Error producing documentation - look for doxygen log file"
fi
else
  echo "Documentation not produced as requested"
fi
cd $SMITER_DIR
