#! /bin/bash --norc
swd=$PWD
if [[ ! -z "$SMITER_DIR" ]] ; then
        cd $SMITER_DIR
else
	cd $HOME/smardda-pfc
fi
if [[ -z "$SMALIB_DIR" ]] ; then
   export SMALIB_DIR=${PWD%/*}/smardda-lib
fi
#(cd fortd;make)
cd f95
# next line unnecessary - following line meant?
ln -sf ../fortd LIB
(cd $SMALIB_DIR/f95;ln -sf ../fortd LIB)
#extra make helps with file syncing
make -f Makefile.geoq
for i in geoq powcal magtfm hdsgen; do make -f Makefile.$i ; done
for i in smanal vtktfm datvtk ctlgen parse; do make -f Makefile.$i ; done
make -f Makefile.smiter

for i in geoq powcal smanal magtfm vtktfm datvtk hdsgen ctlgen parse smiter ; do mv -f $i ../exec ;done
cd $swd
