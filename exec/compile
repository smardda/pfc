#! /bin/bash --norc
set -e
swd=$PWD
if [[ ! -z "$SMITER_DIR" ]] ; then
        cd $SMITER_DIR
else
	cd $HOME/smardda-pfc
fi
if [[ -z "$SMALIB_DIR" ]] ; then
   export SMALIB_DIR=${PWD%/*}/smardda-lib
fi
#(cd fortd;make)
cd f95
ln -sf ../fortd LIB
for i in geoq powcal magtfm hdsgen antest smanal; do make -f Makefile.$i ; done
#for i in smanal vtktfm datvtk ctlgen parse; do make -f Makefile.$i ; done
make -f Makefile.smiter

for i in geoq powcal smanal magtfm hdsgen smiter antest ; do mv -f $i ../exec ;done

make -f Makefile.smiter libexec
for i in geofil move vtktfm datvtk ctlgen parse ; do mv -f $SMALIB_DIR/f95/$i ../exec ;done
cd $swd
