# basic Makefile

# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
ctlgen.F90
 
PROG = ctlgen
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.F90=.mod)

OBJECTS=$(SOURCES:.F90=.o)

$(PROG) : $(OBJECTS)
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.F90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MOD) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean


ctlgen.F90 : const_kind_m.mod
ctlgen.F90 : date_time_m.mod
ctlgen.F90 : log_m.mod
ctlgen.F90 : misc_m.mod
ctlgen.F90 : ccontrol_m.mod
