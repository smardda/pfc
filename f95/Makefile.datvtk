# basic Makefile

# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
datvtk.f90
 
PROG = datvtk
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.f90=.mod)

OBJECTS=$(SOURCES:.f90=.o)

$(PROG) : $(OBJECTS) lib
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.f90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MOD) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

lib :
	cd $(SMAPATH)/LIB && $(MAKE) 
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib lib

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean lib


datvtk.f90 : const_kind_m.mod
datvtk.f90 : const_numphys_h.mod
datvtk.f90 : date_time_m.mod
datvtk.f90 : control_h.mod
