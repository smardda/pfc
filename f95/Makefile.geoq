# basic Makefile

$(info >>> ENTERING $(lastword $(MAKEFILE_LIST)))
# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
antenna_h.f90 \
bcontrol_m.f90 \
geoq_h.f90 \
geoq_m.f90 \
goutfile_m.f90 \
mcontrol_m.f90 \
powcal_h.f90 \
powres_h.f90 \
prcontrol_h.f90 \
radnsource_h.f90 \
radnsource_m.f90 \
ray_m.f90 \
skyl_h.f90 \
skyl_m.f90 \
smitermpi_m.f90 \
geoq.f90
 
PROG = geoq
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.f90=.mod)

EXTRA_MODULES = geoq_p.mod

OBJECTS=$(SOURCES:.f90=.o)


$(PROG) : lib $(OBJECTS)
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.f90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MODULES) $(EXTRA_MODULES) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

lib :
	cd $(SMAPATH)/LIB && $(MAKE) 
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib lib

deepclean : clean
	cd $(SMAPATH)/LIB && $(MAKE) clean
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib clean

deeplibclean : clean
	cd $(SMAPATH)/LIB && $(MAKE) libclean
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib libclean

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean lib deepclean deeplibclean

bcontrol_m.f90 : skyl_h.mod
bcontrol_m.f90 : skyl_m.mod
geoq_h.f90 : skyl_h.mod
geoq_m.f90 : bcontrol_m.mod
geoq_m.f90 : geoq_h.mod
geoq_m.f90 : skyl_h.mod
geoq_m.f90 : skyl_m.mod
geoq_m.f90 : smitermpi_m.mod
goutfile_m.f90 : bcontrol_m.mod
goutfile_m.f90 : geoq_h.mod
goutfile_m.f90 : skyl_h.mod
goutfile_m.f90 : skyl_m.mod
powcal_h.f90 : antenna_h.mod
powcal_h.f90 : powres_h.mod
powcal_h.f90 : prcontrol_h.mod
powcal_h.f90 : radnsource_h.mod
powcal_h.f90 : ray_m.mod
powres_h.f90 : skyl_h.mod
radnsource_m.f90 : radnsource_h.mod
ray_m.f90 : radnsource_h.mod
ray_m.f90 : radnsource_m.mod
skyl_m.f90 : skyl_h.mod
smitermpi_m.f90 : powcal_h.mod
smitermpi_m.f90 : powres_h.mod
geoq.f90 : antenna_h.mod
geoq.f90 : bcontrol_m.mod
geoq.f90 : geoq_h.mod
geoq.f90 : geoq_m.mod
geoq.f90 : goutfile_m.mod
geoq.f90 : mcontrol_m.mod
geoq.f90 : powcal_h.mod
geoq.f90 : powres_h.mod
geoq.f90 : prcontrol_h.mod
geoq.f90 : radnsource_h.mod
geoq.f90 : radnsource_m.mod
geoq.f90 : ray_m.mod
geoq.f90 : skyl_h.mod
geoq.f90 : skyl_m.mod
geoq.f90 : smitermpi_m.mod
