# basic Makefile

# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
bcontrol_m.F90 \
beqan_h.F90 \
beqan_m.F90 \
beq_m.F90 \
geoq_h.F90 \
geoq_m.F90 \
goutfile_m.F90 \
mcontrol_h.F90 \
mcontrol_m.F90 \
moutfile_m.F90 \
skyl_h.F90 \
skyl_m.F90 \
geoq.F90
 
PROG = geoq
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.F90=.mod)

OBJECTS=$(SOURCES:.F90=.o)

$(PROG) : $(OBJECTS)
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.F90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MOD) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean


