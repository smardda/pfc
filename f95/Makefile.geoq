# basic Makefile

# config file.
include ../config/config.inc
 
# Libraries
LIBS = ./LIB/lib$(DBG).a

SOURCES = \
const_kind_m.F90 \
const_numphys_h.F90 \
date_time_m.F90 \
control_h.F90 \
dcontrol_h.F90 \
log_m.F90 \
misc_m.F90 \
clock_m.F90 \
position_h.F90 \
fmesh_h.F90 \
