# basic Makefile

# config file.
$(info >>> ENTERING $(lastword $(MAKEFILE_LIST)))
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
skyl_h.f90 \
powcal_h.f90 \
powres_h.f90 \
smitermpi_m.f90 \
hdsgen.f90
 
PROG = hdsgen
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.f90=.mod)

EXTRA_MODULES = hdsgen_p.mod

OBJECTS=$(SOURCES:.f90=.o)

$(PROG) : lib $(OBJECTS)
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.f90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MODULES) $(EXTRA_MODULES) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

lib :
	cd $(SMAPATH)/LIB && $(MAKE) 
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib lib

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean lib


