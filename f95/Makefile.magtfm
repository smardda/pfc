# basic Makefile

$(info >>> ENTERING $(lastword $(MAKEFILE_LIST)))
# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
apb_h.f90 \
apb_m.f90 \
mcontrol_m.f90 \
smitermpi_m.f90 \
magtfm.f90
 
PROG = magtfm
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.f90=.mod)

EXTRA_MODULES = magtfm_p.mod

OBJECTS=$(SOURCES:.f90=.o)


$(PROG) : lib $(OBJECTS)
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.f90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MODULES) $(EXTRA_MODULES) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

lib :
	cd $(SMAPATH)/LIB && $(MAKE) 
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib lib

deepclean : clean
	cd $(SMAPATH)/LIB && $(MAKE) clean
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib clean

deeplibclean : clean
	cd $(SMAPATH)/LIB && $(MAKE) libclean
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib libclean

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean lib deepclean deeplibclean

apb_m.f90 : apb_h.mod
apb_m.f90 : mcontrol_m.mod
smitermpi_m.f90 : powcal_h.mod
smitermpi_m.f90 : powres_h.mod
magtfm.f90 : apb_h.mod
magtfm.f90 : apb_m.mod
magtfm.f90 : mcontrol_m.mod
magtfm.f90 : smitermpi_m.mod
