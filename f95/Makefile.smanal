# basic Makefile

# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
smanal_h.F90 \
smanal_m.F90 \
soutfile_m.F90 \
smanal.F90
 
PROG = smanal
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.F90=.mod)

OBJECTS=$(SOURCES:.F90=.o)

$(PROG) : $(OBJECTS) lib
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.F90
	$(F90) $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MOD) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)
lib :
	cd $(SMAPATH)/LIB && $(MAKE) 
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib lib

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean $(LIBF90) $(LIBS) lib


