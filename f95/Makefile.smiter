# basic Makefile

# config file.
include ../config/config.inc
 
# Path and libraries
include ../config/path.inc

SOURCES = \
powres_h.f90 \
powcal_h.f90 \
smitermpi_m.f90 \
bcontrol_m.f90 \
geoq_h.f90 \
geoq_m.f90 \
goutfile_m.f90 \
mcontrol_m.f90 \
skyl_h.f90 \
skyl_m.f90 \
geoq.f90 \
hdsgen.f90 \
pcontrol_m.f90 \
poutfile_m.f90 \
powcal_m.f90 \
powelt_m.f90 \
termplane_m.f90 \
powcal.f90 \
smiter.f90
 
PROG = smiter
 

VPATH=$(SMAPATH)

MODULES=$(SOURCES:.f90=.mod)

OBJECTS=$(SOURCES:.f90=.o)

$(PROG) : $(OBJECTS)
	$(F90) $(F90FLAGS) -o $(PROG) $(OBJECTS) $(LIBF90) $(LIBS)

$(OBJECTS):$(MODULES)
	@touch .TOUCHFILE

$(MODULES): %.mod : %.f90
	$(F90) -D COMBINED $(F90FLAGS) -I$(SMAPATH) -c $<

clean:
	rm -f $(OBJECTS) *$(MOD) $(EXTRA_CLEAN_FILES)

distclean: clean
	rm -f $(PROG)

lib :
	cd $(SMAPATH)/LIB && $(MAKE) 
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib lib

deepclean : clean
	cd $(SMAPATH)/LIB && $(MAKE) clean
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib clean

deeplibclean : clean
	cd $(SMAPATH)/LIB && $(MAKE) libclean
	cd $(SMAPATH) && $(MAKE) -f Makefile.lib libclean

txt:
	cat Makefile.$(PROG) $(SOURCES) > $(PROG).txt

.PHONY : clean distclean lib deepclean deeplibclean

